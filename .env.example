# SupportIQ Environment Configuration Template

# App Settings
APP_NAME=SupportIQ
ENVIRONMENT=development
LOG_LEVEL=INFO

# Free & Zero-Storage LLM Provider ("google", "groq", or "ollama")
LLM_PROVIDER=google

# Free API Keys (Zero Local Disk Overhead)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GROQ_API_KEY=your_groq_cloud_api_key_here

# Default Model Selection
DEFAULT_MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Vector Search Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=4
SIMILARITY_THRESHOLD=0.65

# Security Controls
ENFORCE_ORDER_OWNERSHIP=true
